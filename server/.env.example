# ==============================================================================
# CloudVault Server - Environment Configuration Template
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-cloudvault-app.vercel.app

# Database Connection (MongoDB Atlas in Production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cloudvault?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_string_for_production
JWT_EXPIRES_IN=7d

# Default User Quota (1 GB in bytes: 1073741824)
DEFAULT_STORAGE_QUOTA=1073741824

# Storage Provider Strategy: 'cloudinary', 's3', or 'local'
# NOTE: Cloudinary or S3 is recommended for Render because Render instances are ephemeral
STORAGE_PROVIDER=cloudinary

# Cloudinary Storage Settings (Recommended for Production)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# S3-Compatible Storage Provider Settings (Alternative)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
