# ==============================================================================
# CloudVault Environment Configuration Template
# Copy this file to .env (in server directory or root)
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/cloudvault

# JWT Authentication
JWT_SECRET=super_secret_cloudvault_jwt_key_development_only_change_in_production
JWT_EXPIRES_IN=7d

# Default User Quota (1 GB in bytes: 1073741824)
DEFAULT_STORAGE_QUOTA=1073741824

# Storage Provider Strategy: 'local', 's3', or 'cloudinary'
STORAGE_PROVIDER=local

# Local Storage Provider Settings (used when STORAGE_PROVIDER=local)
LOCAL_STORAGE_DIR=./uploads

# Cloudinary Storage Provider Settings (used when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=471494995399617
CLOUDINARY_API_SECRET=
# Or full URL:
# CLOUDINARY_URL=cloudinary://471494995399617:your_api_secret@your_cloud_name

# S3-Compatible Storage Provider Settings (used when STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
# Set AWS_S3_FORCE_PATH_STYLE to true for MinIO or localstack
AWS_S3_FORCE_PATH_STYLE=false
